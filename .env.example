# Copy this file to .env and fill in what you have. Everything is optional:
# anything left empty falls back to simulated mode in the app.
# .env is git-ignored, so your secrets never reach GitHub.

# PayPal Sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox → your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Google Gemini (aistudio.google.com/apikey). Lets visitors use the real AI without their own key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sandbox business account email that receives Study Kit Agent purchases
STORE_MERCHANT_EMAIL=

PORT=3000
